# Knowledge — copy to .env. Every value here is optional; the defaults are in docker-compose.yml.

# The port the map is served on. → http://localhost:8080
WEB_PORT=8080

# The uid:gid the ontology container runs as. Writes commit into data/repo on the host, so this must
# own that directory. ./install.sh appends your own; `id -u` / `id -g` if you write it by hand.
#KNOWLEDGE_UID=1000
#KNOWLEDGE_GID=1000

# Where the three bind mounts come from on the host. mkdir them before compose.
#KNOWLEDGE_DATA_DIR=./data/repo
#KNOWLEDGE_PUBLISH_DIR=./data/publish
#KNOWLEDGE_OVERLAYS_DIR=./data/overlays
#KNOWLEDGE_HARNESS_DIR=./data/harness

# The name stamped on commits made through the screen.
KNOWLEDGE_ACTOR=web

# ---- the door on the screen -------------------------------------------------
# open | token | proxy. `open` is the default and what every install has been: anyone who can reach
# the port can call every write API. That is legitimate on a network where it is acceptable, and the
# difference now is that the running service says so — in its log, in /api/app-config, and on the
# screen — instead of only the README knowing.
#
#   token   a shared secret, presented as `Authorization: Bearer …`. Answers *may you write* and
#           nothing about *who you are*, so the name on a commit stays a signature. For an agent, a
#           script, a deployment where the browser is not the point.
#   proxy   an authenticating reverse proxy in front, and its header read only from an address named
#           in KNOWLEDGE_AUTH_TRUSTED_PROXY. The only mode that produces an actor worth the name, and
#           there it replaces what the client sent rather than falling back to it.
#
# A mode that cannot be safe does not start: `token` with no secret, `proxy` with no trusted source.
KNOWLEDGE_AUTH=open
#KNOWLEDGE_TOKEN=
# The header the proxy sets. Whatever yours is called — oauth2-proxy sends X-Forwarded-Email.
#KNOWLEDGE_AUTH_HEADER=X-Forwarded-Email
# Where that header is believed from: an address, a CIDR, a comma-separated list — or the literal
# `any` when the network itself is what guarantees nothing else can reach this port. Believing the
# header from anywhere is worse than no authentication at all, because anybody can send one and the
# record then names a person who was not there. Spelled out and ugly on purpose.
#KNOWLEDGE_AUTH_TRUSTED_PROXY=
# Guard reads as well as writes. Off by default: reads are what an agent does through the MCP, which
# has no session and did not ask for one, so turning this on means giving the agent the secret too.
#KNOWLEDGE_AUTH_READS=

# Where "▶ Start" sends the areas a person picked. Empty = that button is not drawn.
KNOWLEDGE_AGENT_URL=

# Optional LLM — the ✨ Suggest buttons. Unset = they are shown disabled, nothing else changes.
# Provider: litellm (default, anything OpenAI-shaped) · openai · anthropic. Base URL without /v1.
ONTOLOGY_LLM_PROVIDER=litellm
ONTOLOGY_LLM_BASE_URL=
ONTOLOGY_LLM_API_KEY=
ONTOLOGY_LLM_MODEL=
ONTOLOGY_LLM_MAX_TOKENS=
ONTOLOGY_LLM_TEMPERATURE=

# One ontology per data directory. Two on the same mount used to tear each other apart in ways that
# never look like a race — writes refused as "someone edited the repository by hand", writes committed
# under the other process's message, the tree left dirty so every later write is refused. They now
# take turns on a lock in .git/, and this is how long one waits before answering that another process
# is holding it. Raise it only if your writes are genuinely slower than this.
#ONTOLOGY_LOCK_WAIT=20

# ── Links to other backbones ──────────────────────────────────────────────────
# All of this is off unless you set it, and that is the right default: opening a link is a decision,
# not something an install drifts into. Who this backbone is linked to lives in `peers.yaml` in the
# data repository — versioned and reviewed, like everything else about what this backbone is. Only
# the secrets are here. docs/PEERING.md.

# The secret between this backbone and its exchange — the same one in both directions, which is what
# lets the exchange tell who is calling. `install.sh` generates it on the first run and keeps it; there
# is nothing to fill in here. Every further backbone gets its own, printed by the operator's screen.
#EXCHANGE_TOKEN_HOME=

# How long a peer's answer — success or failure — is reused before asking again, and how long to wait
# on a peer that is not answering. The cache is for the sad path: without it a link that is down costs
# every request the full timeout. It is short because of what it bounds — while a success is cached, a
# link that just died still reads as alive, and hop 0 still says absence may be claimed.
#ONTOLOGY_PEER_TTL=5
#ONTOLOGY_PEER_TIMEOUT=4

# ── A second backbone, and an exchange, for trying links out ──────────────────
# Only read by docker-compose.peer.yml and docker-compose.exchange.yml; the ordinary install is one
# backbone and ignores all of this. docs/PEERING.md.

# The second install: where its four directories live, what port its screen is on, and the name on
# commits made through that screen.
#KNOWLEDGE_B_DATA_DIR=./data-b/repo
#KNOWLEDGE_B_PUBLISH_DIR=./data-b/publish
#KNOWLEDGE_B_OVERLAYS_DIR=./data-b/overlays
#KNOWLEDGE_B_HARNESS_DIR=./data-b/harness
#WEB_PORT_B=8081
#KNOWLEDGE_ACTOR_B=web-b

# The second backbone's secret with the exchange. Its own, not shared with the first: one per
# member is what lets the exchange tell who is calling, and spare each its own advertisement.
#EXCHANGE_TOKEN_BRANCH=

# The exchange: what it calls itself — the name that appears in a row's path and the one it drops a
# row on having seen — and where its members.yaml lives.
#EXCHANGE_NAME=ix
#KNOWLEDGE_EXCHANGE_DIR=./data/exchange

# ── The operator's screen for an exchange ─────────────────────────────────────
# Only read by docker-compose.admin.yml. Unset — the default — and the exchange has no operator door
# at all: /admin answers 501 and the screen says so. That is the right default for a service that may
# one day face another organisation. docs/PEERING.md.
#EXCHANGE_ADMIN_TOKEN=
#ADMIN_PORT=8090
